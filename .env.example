# ====================================================================
# ForwardBin Environment Configuration Example
# ====================================================================
# In CI/CD or production environments, supply these via environment
# variables or secret managers (e.g. GitHub Actions Secrets, Doppler).

# 1. AI Content Analysis (OpenRouter API)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 2. Email Notifications (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER=forwardbin@yourdomain.com
USER_EMAIL=you@example.com

# 3. Optional Integrations
YOUTUBE_API_KEY=your_youtube_api_key_here
GCAL_ICAL_FEED_URL=https://calendar.google.com/calendar/ical/.../basic.ics
USER_TIMEZONE=Asia/Kolkata
